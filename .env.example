# ==============================================================================
# ATTEST PLATFORM — DUAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Attest supports two distinct operating environments:
#   1. PRODUCTION: Clean Supabase PostgreSQL project. Zero fictional demo data.
#   2. STAGING / DEMO: Demo Supabase project with Meridian Textiles demonstration data.
#
# IMPORTANT:
# - Prisma schema (prisma/schema.prisma) is the single source of truth.
# - Tables are generated via: npx prisma db push
# - Production must NEVER be seeded with fictional data (SEED_DEMO_DATA=false).
# ==============================================================================

# ------------------------------------------------------------------------------
# MODE 1: PRODUCTION ENVIRONMENT (Active when deploying to Production)
# ------------------------------------------------------------------------------
# 1. Database Connection (Supabase PostgreSQL)
# - Use the Transaction Pooled connection string (port 6543) for Next.js serverless routes
# - Use the Direct connection string (port 5432) for DIRECT_URL during migrations
DATABASE_URL="postgresql://postgres.[PROD_PROJECT_REF]:[YOUR_PROD_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROD_PROJECT_REF]:[YOUR_PROD_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Authentication (NextAuth.js v4)
# - Canonical production URL without trailing slash
NEXTAUTH_URL="https://attest.pk"
# - Generate a cryptographically random 32+ character secret (e.g., openssl rand -base64 32)
NEXTAUTH_SECRET="your-secure-32-character-random-production-secret-here"

# 3. Supabase API & Storage Configuration
# - Found in Supabase Console -> Project Settings -> API
SUPABASE_URL="https://[PROD_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-production-anon-key"
# - Service role key: SERVER-SIDE ONLY. Used by storage adapter to manage private buckets
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-production-service-role-key"
# - Storage provider: "supabase" (production) or "local" (offline fallback)
STORAGE_PROVIDER="supabase"
SUPABASE_STORAGE_BUCKET="evidence"

# 4. Production Safeguards (CRITICAL)
# - DEMO_MODE must strictly be "false" in production
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
# - SEED_DEMO_DATA must strictly be "false" in production to prevent accidental poisoning
SEED_DEMO_DATA="false"

# 5. Cryptographic Certificate Signing Engine
# - Secret HMAC signing key for certificate integrity verification
SIGNING_KEY="your-production-hmac-sha256-signing-key-minimum-32-bytes"
# - Development-mode transparency disclosure ("DEVELOPMENT" or "QUALIFIED")
SIGNING_MODE="DEVELOPMENT"

# 6. Admin Pre-Launch Healthcheck Secret Token
ADMIN_CHECK_TOKEN="optional-secret-bearer-token-for-infra-monitoring"


# ==============================================================================
# MODE 2: STAGING / DEMONSTRATION ENVIRONMENT (Copy into .env for Demo testing)
# ==============================================================================
# To run Staging/Demo pointing to your Demo Supabase project, replace variables with:
#
# DATABASE_URL="postgresql://postgres.[DEMO_PROJECT_REF]:[YOUR_DEMO_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[DEMO_PROJECT_REF]:[YOUR_DEMO_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# NEXTAUTH_URL="https://staging.attest.pk"
# NEXTAUTH_SECRET="staging-environment-secret-32-chars-long-minimum-key"
# SUPABASE_URL="https://[DEMO_PROJECT_REF].supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-demo-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-demo-service-role-key"
# STORAGE_PROVIDER="supabase"
# SUPABASE_STORAGE_BUCKET="evidence"
# DEMO_MODE="true"
# NEXT_PUBLIC_DEMO_MODE="true"
#
# # Seeding Staging:
# # Set SEED_DEMO_DATA="true" ONLY when running `npx prisma db seed` against Staging.
# SEED_DEMO_DATA="true"
# SIGNING_KEY="staging-hmac-sha256-signing-key-32-bytes"
# SIGNING_MODE="DEVELOPMENT"


# ==============================================================================
# MODE 3: LOCAL OFFLINE DEVELOPMENT (SQLite fallback)
# ==============================================================================
# DATABASE_URL="file:./dev.db"
# NEXTAUTH_URL="http://localhost:3001"
# NEXTAUTH_SECRET="attest-development-secret-key-32-chars-long-minimum"
# STORAGE_PROVIDER="local"
# DEMO_MODE="true"
# NEXT_PUBLIC_DEMO_MODE="true"
# SEED_DEMO_DATA="true"
# SIGNING_KEY="local-dev-hmac-sha256-signing-key-32-bytes"
# SIGNING_MODE="DEVELOPMENT"
